---
import Layout from '../layouts/Layout.astro';
import { currentExpedition } from '../lib/data';
---
<Layout title="Log in" description="Log in with Discord to see members-only pages." noindex>
  <section class="card gate">
    <svg viewBox="0 0 24 24" width="40" height="40" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="2" /></svg>
    <h1>Members only</h1>
    <p class="muted">This page is for approved Eden members. Log in with Discord to continue.</p>
    <a class="discord-btn" id="go" href={`/auth/discord?next=${encodeURIComponent(`/members/expedition/${currentExpedition}/`)}`}>Log in with Discord</a>
    <p class="muted small">The site only sees your Discord username and ID, to check you're on the list.</p>
  </section>
</Layout>

<script>
  const next = new URLSearchParams(location.search).get('next');
  const go = document.getElementById('go') as HTMLAnchorElement | null;
  if (go && next && next.startsWith('/members/')) go.href = `/auth/discord?next=${encodeURIComponent(next)}`;
</script>

<style>
  .gate { align-items: center; text-align: center; padding-block: 2.5rem; max-width: 560px; margin-inline: auto; width: 100%; }
  .gate svg { color: var(--accent-ink); }
  .gate h1 { font-size: 1.8rem; }
</style>
