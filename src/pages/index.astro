---
import Layout from '../layouts/Layout.astro';
import { guilds, categories, regions, totalPlayers, currentExpedition, fmtInt, fmtDate, updated } from '../lib/data';
---
<Layout>
  <section class="hero">
    <img class="logo" src="/eden-logo.webp" width="400" height="400" alt="Eden" fetchpriority="high" />
    <div class="page-head">
      <span class="eyebrow">Eden Guild Alliance</span>
      <h1>{guilds.length} guilds across {regions.length} regions</h1>
      <p class="lede">Every guild in the alliance, with its region, guild ID and leaders. Use the guild ID to find a guild in game.</p>
    </div>
  </section>

  <div class="tiles">
    <div class="tile"><span class="k">Guilds</span><span class="v">{guilds.length}</span></div>
    <div class="tile"><span class="k">Members</span><span class="v">{fmtInt(totalPlayers)}</span></div>
    <div class="tile"><span class="k">Regions</span><span class="v">{regions.length}</span></div>
    {currentExpedition && <a class="tile" href={`/expedition/${currentExpedition}/`}><span class="k">Expedition</span><span class="v">{currentExpedition}</span><span class="muted small">Maps and leagues →</span></a>}
  </div>

  <section class="directory" aria-labelledby="dir-h">
    <div class="dir-head">
      <h2 id="dir-h">Guild directory</h2>
      <div class="controls">
        <label class="sr" for="q">Find a guild</label>
        <input id="q" class="filter" type="search" placeholder="Name, leader or guild ID" autocomplete="off" />
        <div class="chips" role="group" aria-label="Region">
          <button class="chip" type="button" data-region="" aria-pressed="true">All regions</button>
          {regions.map((r) => <button class="chip" type="button" data-region={r} aria-pressed="false">R{r}</button>)}
        </div>
      </div>
    </div>

    {categories.map((cat) => (
      <section class="cat" data-cat>
        <h3 class="cat-h">{cat}</h3>
        <ul class="grid">
          {guilds.filter((g) => g.category === cat).map((g) => (
            <li class="g" style={`--gc:${g.color}`} data-region={g.region ?? ''} data-text={[g.name, g.leader, ...g.deputies, g.id].join(' ').toLowerCase()}>
              <a href={`/guild/${g.id}/`}>
                <span class="g-top"><span class="dot" style={`background:${g.color}`}></span><strong>{g.name}</strong>{g.status !== 'Active' && <span class="tag">{g.status}</span>}</span>
                <span class="g-meta">Region {g.region ?? '—'} · ID {g.id}</span>
                <span class="g-meta">Leader <b>{g.leader || '—'}</b></span>
                <span class="g-foot">{g.players > 0 ? `${g.players} members` : 'Members not listed yet'}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <p class="muted" id="none" hidden>No guild matches that.</p>
    {updated && <p class="muted small">Member counts updated {fmtDate(updated)}.</p>}
  </section>
</Layout>

<style>
  .hero { display: flex; align-items: center; gap: 1.5rem; }
  .logo { width: 170px; height: auto; flex: none; filter: drop-shadow(0 6px 22px rgba(61, 139, 255, .22)); }
  @media (max-width: 640px) {
    .hero { flex-direction: column; text-align: center; gap: .75rem; }
    .hero .page-head { align-items: center; }
    .logo { width: min(220px, 60vw); }
  }
  .directory { display: flex; flex-direction: column; gap: 1.5rem; }
  .dir-head { display: flex; flex-direction: column; gap: .75rem; }
  .controls { display: flex; flex-direction: column; gap: .6rem; }
  .filter { width: 100%; max-width: 380px; padding: .6rem .8rem; font: inherit; color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: 8px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .cat { display: flex; flex-direction: column; gap: .6rem; }
  .cat-h { font-family: var(--font-display); font-size: 1rem; letter-spacing: .04em; color: var(--accent-ink); }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: .8rem; }
  .g a { display: flex; flex-direction: column; gap: .25rem; height: 100%; background: var(--surface); border: 1px solid var(--line); border-top: 4px solid var(--gc); border-radius: var(--radius); padding: .85rem 1rem; text-decoration: none; }
  .g a:hover { border-color: var(--gc); color: inherit; box-shadow: 0 2px 10px color-mix(in srgb, var(--gc) 25%, transparent); }
  .g-top { display: flex; align-items: center; gap: .45rem; font-size: 1.05rem; }
  .g-meta { font-size: .85rem; color: var(--muted); }
  .g-meta b { color: var(--ink); font-weight: 500; }
  .g-foot { margin-top: auto; padding-top: .35rem; font-size: .8rem; color: var(--muted); }
  .tag { font-size: .7rem; border: 1px solid var(--line); border-radius: 999px; padding: 0 .45rem; color: var(--muted); }
</style>

<script>
  const q = document.getElementById('q') as HTMLInputElement;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('button[data-region]')];
  const cards = [...document.querySelectorAll<HTMLElement>('li.g')];
  const cats = [...document.querySelectorAll<HTMLElement>('[data-cat]')];
  let region = '';
  function apply() {
    const term = q.value.trim().toLowerCase();
    let shown = 0;
    for (const c of cards) {
      const ok = (!region || c.dataset.region === region) && (!term || (c.dataset.text ?? '').includes(term));
      c.hidden = !ok;
      if (ok) shown++;
    }
    for (const s of cats) s.hidden = !s.querySelector('li.g:not([hidden])');
    document.getElementById('none')!.hidden = shown > 0;
  }
  q.addEventListener('input', apply);
  for (const b of chips) b.addEventListener('click', () => {
    region = b.dataset.region ?? '';
    chips.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    apply();
  });
</script>
