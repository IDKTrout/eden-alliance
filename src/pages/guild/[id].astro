---
import Layout from '../../layouts/Layout.astro';
import StackBar from '../../components/StackBar.astro';
import Emblem from '../../components/Emblem.astro';
import { guilds, guildHistory, leagueGroups, splitLeague, mapColor, mapLabel, leagueColor, inkOn, currentExpedition, pct, ACCURACY_NOTE, abex, abexSeasons, rift, riftSeasons, seasonSlug, seasonName, fmtDamage, fmtInt, playersIn, fmtPower, type Guild } from '../../lib/data';

export function getStaticPaths() {
  return guilds.map((g) => ({ params: { id: g.id }, props: { g } }));
}
const { g } = Astro.props as { g: Guild };
const history = guildHistory(g);
const current = history.find((h) => h.id === currentExpedition)?.entry;
const abexRows = abexSeasons.flatMap((s) => abex.filter((r) => r.season === s && r.guildRecord?.id === g.id));
const riftRows = riftSeasons.flatMap((s) => rift.filter((r) => r.season === s && r.guildRecord?.id === g.id).sort((a, b) => (a.place ?? 1e9) - (b.place ?? 1e9)));
// This guild's leagues in the current expedition, with the other guilds in the same map and league.
const myLeagues = current
  ? current.leagues.map((t) => {
      const { map, league } = splitLeague(t.key);
      const group = leagueGroups(currentExpedition).find((m) => m.map === map)?.groups.find((x) => x.league === league);
      return { map, league, count: t.count, others: (group?.guilds ?? []).filter((x) => x.guildRecord?.id !== g.id) };
    }).sort((a, b) => b.count - a.count)
  : [];
const members = playersIn(g);
const guildPower = members.reduce((s, p) => s + (p.power ?? 0), 0);
const sameRegion = guilds.filter((o) => o.active && o.region === g.region && o.id !== g.id);
---
<Layout title={g.name} description={`${g.name}: ${g.active ? '' : 'former '}${g.category} of the Eden Alliance in Region ${g.region}.${g.gameId ? ` Guild ID ${g.gameId}.` : ''}`}>
  <a class="muted small back" href="/">← All guilds</a>
  <section class="head" style={`--gc:${g.color}`}>
    <Emblem guild={g} size={128} eager />
    <div class="page-head">
      <span class="eyebrow">{g.active ? g.category : `Inactive · was a ${g.category.toLowerCase()}`} · Region {g.region ?? '—'}</span>
      <h1>{g.name}</h1>
      {g.purpose && <p class="lede">{g.purpose}</p>}
    </div>
  </section>

  <div class="tiles">
    <div class="tile">
      <span class="k">Guild ID</span>
      <span class="v id">{g.gameId || '—'}</span>
      {g.gameId && <button class="copy" type="button" data-copy={g.gameId}>Copy ID</button>}
    </div>
    <div class="tile"><span class="k">Members</span><span class="v">{g.players || '—'}</span></div>
    <div class="tile"><span class="k">Region</span><span class="v">{g.region ?? '—'}</span></div>
    <div class="tile"><span class="k">Status</span><span class="v status">{g.status}</span></div>
  </div>

  {(g.leader || g.deputies.length > 0) && <section class="card">
    <h2>Leadership</h2>
    <dl class="lead">
      <div><dt>Leader</dt><dd>{g.leader || '—'}</dd></div>
      {g.deputies.length > 0 && <div><dt>Deputies</dt><dd>{g.deputies.join(', ')}</dd></div>}
    </dl>
  </section>}

  {members.length > 0 && (
    <section class="card">
      <div class="mhead">
        <h2>Members</h2>
        <span class="muted small">{members.length} players · {fmtPower(guildPower)} total power · <a href={`/power/?guild=${g.id}`}>In the power rankings →</a></span>
      </div>
      <ol class="members">
        {members.map((p) => (
          <li>
            <span class="mr muted">{p.guildRank}</span>
            <span class="mn">{p.id ? <a href={`/player/${p.id}/`}>{p.name}</a> : p.name}{p.role && <span class="role">{p.role}</span>}</span>
            <span class="mp">{fmtPower(p.power)}</span>
          </li>
        ))}
      </ol>
    </section>
  )}

  {current && (
    <section class="card">
      <h2>Expedition {currentExpedition}</h2>
      <p class="muted small">{current.mapped} of {current.players} players have a map entered ({pct(current.mapped, current.players)}%). <a href={`/expedition/${currentExpedition}/`}>All guilds →</a></p>
      <div class="bars">
        <span class="bl">Maps</span><StackBar parts={current.maps} total={current.players} color={mapColor} label={mapLabel} />
      </div>
      {myLeagues.length > 0 && (
        <ul class="myleagues">
          {myLeagues.map((l) => (
            <li>
              <span class="pill" style={`background:${mapColor(l.map)};color:${inkOn(mapColor(l.map))}`}>{l.map}</span>
              <span class="pill" style={`background:${leagueColor(l.league)};color:${inkOn(leagueColor(l.league))}`}>{l.league}</span>
              <span><b>Map {l.map}, League {l.league}</b>: {l.count} player{l.count === 1 ? '' : 's'}{l.others.length > 0
                ? <span class="muted">, with {l.others.map((o, i) => <>{i > 0 && ', '}{o.guildRecord ? <a href={`/guild/${o.guildRecord.id}/`}>{o.guild}</a> : o.guild} ({o.count})</>)}</span>
                : <span class="muted">, no other Eden guild</span>}</span>
            </li>
          ))}
        </ul>
      )}
    </section>
  )}

  {history.length > 0 && (
    <section class="card">
      <h2>Expedition history</h2>
      <p class="muted small">{ACCURACY_NOTE}</p>
      <div class="table-wrap"><table class="data">
        <thead><tr><th>Expedition</th><th class="num">Players</th><th>Main map</th><th>Main league</th><th class="num">Entered</th></tr></thead>
        <tbody>
          {history.map(({ id, entry }) => (
            <tr>
              <td><a href={`/expedition/${id}/`}>{id}</a>{entry.listedAs.length > 0 && <span class="listed">listed as {entry.listedAs.join(', ')}</span>}</td>
              <td class="num">{entry.players}</td>
              <td>{entry.mainMap ? <span class="pill" title={mapLabel(entry.mainMap)} style={`background:${mapColor(entry.mainMap)};color:${inkOn(mapColor(entry.mainMap))}`}>{entry.mainMap}</span> : '—'}</td>
              <td>{entry.mainLeague ? (() => { const { map, league } = splitLeague(entry.mainLeague); return <span class="pill" title={`Map ${map}, League ${league}`} style={`background:${leagueColor(league)};color:${inkOn(leagueColor(league))}`}>{map}·{league}</span>; })() : '—'}</td>
              <td class="num">{pct(entry.mapped, entry.players)}%</td>
            </tr>
          ))}
        </tbody>
      </table></div>
    </section>
  )}

  {abexRows.length > 0 && (
    <section class="card">
      <h2>AbEx</h2>
      <div class="table-wrap"><table class="data">
        <thead><tr><th>Season</th><th class="num">Rank</th><th class="num">Damage</th><th class="num">Time</th></tr></thead>
        <tbody>
          {abexRows.map((r) => (
            <tr>
              <td><a href={`/abex/${seasonSlug(r.season)}/`}>{seasonName(r.season)}</a>{r.listedAs && <span class="listed">listed as {r.listedAs}</span>}</td>
              <td class="num">{r.rank != null ? `#${r.rank}` : r.dnp ? 'DNP' : '—'}</td>
              <td class="num">{fmtDamage(r.damage)}{r.percent != null && <span class="muted"> · {r.percent.toFixed(2)}%</span>}</td>
              <td class="num">{r.time ? <strong class="fin">{r.time}</strong> : <span class="muted">DNF</span>}</td>
            </tr>
          ))}
        </tbody>
      </table></div>
    </section>
  )}

  {riftRows.length > 0 && (
    <section class="card">
      <h2>Temporal Rift</h2>
      <div class="table-wrap"><table class="data">
        <thead><tr><th>Season</th><th class="num">Place</th><th>Player</th><th class="num">Floor</th></tr></thead>
        <tbody>
          {riftRows.map((r) => (
            <tr>
              <td><a href={`/rift/${seasonSlug(r.season)}/`}>{seasonName(r.season)}</a>{r.listedAs && <span class="listed">listed as {r.listedAs}</span>}</td>
              <td class="num">{r.place ?? '—'}</td>
              <td>{r.player}</td>
              <td class="num">{r.floor != null ? fmtInt(r.floor) : '—'}</td>
            </tr>
          ))}
        </tbody>
      </table></div>
    </section>
  )}

  {sameRegion.length > 0 && (
    <section class="card">
      <h2>Also in Region {g.region}</h2>
      <div class="chips">{sameRegion.map((o) => <a class="chip" href={`/guild/${o.id}/`}><Emblem guild={o} size={22} />{o.name}</a>)}</div>
    </section>
  )}
</Layout>

<style>
  .listed { display: block; font-size: .72rem; color: var(--muted); }
  .myleagues { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .4rem; font-size: .9rem; }
  .myleagues li { display: flex; align-items: center; gap: .35rem; flex-wrap: wrap; }
  .myleagues b { font-weight: 600; }
  .myleagues a { text-decoration: none; }
  .myleagues a:hover { text-decoration: underline; }
  .mhead { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .3rem 1rem; }
  .members { list-style: none; margin: 0; padding: 0; columns: 3 15rem; column-gap: 1.5rem; }
  .members li { display: grid; grid-template-columns: 1.8rem 1fr auto; gap: .4rem; align-items: baseline; padding: .28rem 0; border-bottom: 1px solid var(--line); break-inside: avoid; font-size: .9rem; }
  .mr { font-size: .75rem; text-align: right; font-variant-numeric: tabular-nums; }
  .mn { min-width: 0; overflow-wrap: anywhere; }
  .mn a { text-decoration: none; }
  .mn a:hover { text-decoration: underline; }
  .mp { font-variant-numeric: tabular-nums; font-weight: 500; }
  .role { margin-left: .35rem; font-size: .64rem; text-transform: uppercase; letter-spacing: .05em; color: var(--accent-ink); }
  .fin { color: var(--accent-ink); }
  .back { margin-bottom: -1.25rem; }
  .head { display: flex; align-items: center; gap: 1.25rem; }
  @media (max-width: 560px) { .head { flex-direction: column; align-items: flex-start; gap: .5rem; } }
  .v.id { font-family: var(--font-body); letter-spacing: .02em; }
  .v.status { font-size: 1.2rem; }
  .copy { align-self: flex-start; margin-top: .2rem; font: inherit; font-size: .78rem; background: var(--raised); color: var(--ink); border: 1px solid var(--line); border-radius: 6px; padding: .15rem .55rem; cursor: pointer; }
  .lead { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: .75rem; margin: 0; }
  .lead dt { font-size: .72rem; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); }
  .lead dd { margin: 0; font-size: 1.05rem; font-weight: 500; }
  .bars { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: .6rem .8rem; }
  .bl { font-size: .8rem; color: var(--muted); }
</style>

<script>
  for (const b of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy ?? ''); b.textContent = 'Copied'; }
      catch { b.textContent = 'Copy failed'; }
      setTimeout(() => (b.textContent = 'Copy ID'), 1500);
    });
  }
</script>
