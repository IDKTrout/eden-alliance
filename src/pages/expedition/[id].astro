---
import Layout from '../../layouts/Layout.astro';
import ExpeditionView from '../../components/ExpeditionView.astro';
import { expeditionIds, currentExpedition } from '../../lib/data';

export function getStaticPaths() {
  return expeditionIds.map((id) => ({ params: { id } }));
}
const { id } = Astro.params as { id: string };
const isCurrent = id === currentExpedition;
const membersUrl = `/members/expedition/${id}/`;
---
{isCurrent ? (
  <Layout title={`Expedition ${id}`} description={`Expedition ${id} is for Eden members only.`}>
    <section class="page-head">
      <span class="eyebrow">Current expedition</span>
      <h1>Expedition {id}</h1>
      <nav class="chips" aria-label="Expeditions">
        {[...expeditionIds].reverse().map((e) => <a class="chip" href={`/expedition/${e}/`} aria-current={e === id ? 'page' : undefined}>{e}</a>)}
      </nav>
    </section>
    <section class="card gate">
      <svg viewBox="0 0 24 24" width="40" height="40" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="2" /></svg>
      <h2>Members only</h2>
      <p class="muted">The current expedition's maps and leagues are only shown to approved Eden members while it's being played. Past expeditions are open to everyone.</p>
      <a class="discord-btn" href={`/auth/discord?next=${encodeURIComponent(membersUrl)}`} data-members-link={membersUrl}>Log in with Discord</a>
    </section>
  </Layout>
) : (
  <Layout title={`Expedition ${id}`} description={`Which maps and leagues each Eden Alliance guild played in expedition ${id}.`}>
    <ExpeditionView id={id} />
  </Layout>
)}

<script>
  // Members who are already logged in skip this page.
  const link = document.querySelector<HTMLAnchorElement>('[data-members-link]');
  if (link) {
    fetch('/auth/me', { credentials: 'same-origin', cache: 'no-store' })
      .then((r) => (r.ok ? r.json() : null))
      .then((me) => { if (me?.allowed) location.replace(link.dataset.membersLink!); })
      .catch(() => {});
  }
</script>

<style>
  .gate { align-items: center; text-align: center; padding-block: 2rem; }
  .gate svg { color: var(--accent-ink); }
  .gate p { max-width: 52ch; }
</style>
