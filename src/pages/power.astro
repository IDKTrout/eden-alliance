---
import Layout from '../layouts/Layout.astro';
import Emblem from '../components/Emblem.astro';
import { players, activeGuilds, totalPower, fmtPower, fmtInt } from '../lib/data';

const top = players[0];
const guildsWithPlayers = activeGuilds.filter((g) => players.some((p) => p.guildRecord?.id === g.id));
---
<Layout title="Power rankings" description="Every Eden Alliance player ranked by power, across all guilds.">
  <section class="page-head">
    <span class="eyebrow">Rankings</span>
    <h1>Power</h1>
    <p class="lede">Every player in the alliance, ranked by power across all guilds.</p>
  </section>

  <div class="tiles">
    <div class="tile"><span class="k">Players</span><span class="v">{fmtInt(players.length)}</span></div>
    <div class="tile"><span class="k">Total power</span><span class="v">{fmtPower(totalPower)}</span></div>
    {top && <div class="tile"><span class="k">Strongest</span><span class="v">{fmtPower(top.power)}</span><span class="muted small">{top.name} · {top.guild}</span></div>}
  </div>

  <section class="card">
    <div class="controls">
      <label class="sr" for="q">Find a player</label>
      <input id="q" class="filter" type="search" placeholder="Player name or ID" autocomplete="off" />
      <label class="sr" for="g">Guild</label>
      <select id="g" class="filter sel">
        <option value="">All guilds</option>
        {guildsWithPlayers.map((g) => <option value={g.id}>{g.name}</option>)}
      </select>
    </div>
    <div class="table-wrap"><table class="data" id="t">
      <thead><tr><th class="num">#</th><th>Player</th><th>Guild</th><th class="num">Power</th><th class="num hide-sm">Arena</th></tr></thead>
      <tbody>
        {players.map((p) => (
          <tr data-g={p.guildRecord?.id ?? ''} data-text={`${p.name} ${p.id}`.toLowerCase()}>
            <td class="num muted">{p.rank}</td>
            <td class="pl">
              {p.id ? <a href={`/player/${p.id}/`}>{p.name}</a> : <span>{p.name}</span>}
              {p.role && <span class="role">{p.role}</span>}
            </td>
            <td><span class="gcell"><Emblem guild={p.guildRecord} size={20} />{p.guildRecord ? <a href={`/guild/${p.guildRecord.id}/`}>{p.guild}</a> : p.guild}</span></td>
            <td class="num"><strong>{fmtPower(p.power)}</strong></td>
            <td class="num hide-sm muted">{p.arena != null ? `#${p.arena}` : ''}</td>
          </tr>
        ))}
      </tbody>
    </table></div>
    <p class="muted" id="none" hidden>No player matches that.</p>
    <p class="muted small">Power comes from each guild's roster on the alliance sheet. Arena is the player's place in their region's top 30, when they're in it.</p>
  </section>
</Layout>

<style>
  .controls { display: flex; flex-wrap: wrap; gap: .6rem; }
  .filter { flex: 1 1 220px; max-width: 360px; padding: .55rem .8rem; font: inherit; color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: 8px; }
  .sel { flex: 0 1 200px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .pl a, .gcell a { text-decoration: none; }
  .pl a { font-weight: 500; }
  .pl a:hover, .gcell a:hover { text-decoration: underline; }
  .gcell { display: inline-flex; align-items: center; gap: .4rem; }
  .role { margin-left: .4rem; font-size: .68rem; text-transform: uppercase; letter-spacing: .05em; color: var(--accent-ink); }
  @media (max-width: 560px) { .hide-sm { display: none; } td.pl { white-space: normal; overflow-wrap: anywhere; } }
</style>

<script>
  const q = document.getElementById('q') as HTMLInputElement;
  const g = document.getElementById('g') as HTMLSelectElement;
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('#t tbody tr')];
  function apply() {
    const term = q.value.trim().toLowerCase();
    let shown = 0;
    for (const r of rows) {
      const ok = (!g.value || r.dataset.g === g.value) && (!term || (r.dataset.text ?? '').includes(term));
      r.hidden = !ok;
      if (ok) shown++;
    }
    document.getElementById('none')!.hidden = shown > 0;
  }
  q.addEventListener('input', apply);
  g.addEventListener('change', apply);
  const pre = new URLSearchParams(location.search).get('guild');
  if (pre && [...g.options].some((o) => o.value === pre)) { g.value = pre; apply(); }
</script>
